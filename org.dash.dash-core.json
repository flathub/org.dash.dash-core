{
    "id": "org.dash.dash-core",
    "runtime": "org.freedesktop.Platform",
    "sdk": "org.freedesktop.Sdk",
    "runtime-version": "24.08",
    "command": "dash-entrypoint.sh",
    "finish-args": [
        "--socket=x11",
        "--socket=pulseaudio",
        "--device=dri",
        "--share=ipc",
        "--share=network",
        "--filesystem=~/.dashcore:create",
        "--filesystem=/run/tor/control.authcookie:ro"
    ],
    "modules": [
        {
            "name": "dash-core",
            "buildsystem": "simple",
            "build-commands": [
                "install -m 0744 -D -t /app/bin/internal bin/dashd",
                "install -m 0744 -D -t /app/bin/internal bin/dash-qt",
                "install -m 0744 -D -t /app/bin/internal bin/dash-cli",
                "install -m 0744 -D -t /app/bin/internal bin/dash-tx",
                "install -m 0744 -D -t /app/bin/internal bin/dash-wallet",
                "install -m 0744 -D -t /app/bin/internal bin/test_dash"
            ],
            "post-install": [
                "/app/bin/internal/test_dash"
            ],
            "sources": [
                {
                    "type": "archive",
                    "only-arches": [
                        "x86_64"
                    ],
                    "url": "https://github.com/dashpay/dash/releases/download/v24.0.3/dashcore-24.0.3-x86_64-linux-gnu.tar.gz",
                    "sha256": "85fb5bb7431b6fb1b62146dee2ed5b554cf0ffda2c7f7734cfaed406a5683cf3",
                    "x-checker-data": {
                        "type": "github",
                        "repo": "dashpay/dash",
                        "tag-pattern": "^v([0-9.]+)$",
                        "asset-name": "dashcore-${version}-x86_64-linux-gnu.tar.gz",
                        "update-group": "dash-core"
                    }
                },
                {
                    "type": "archive",
                    "only-arches": [
                        "aarch64"
                    ],
                    "url": "https://github.com/dashpay/dash/releases/download/v24.0.3/dashcore-24.0.3-aarch64-linux-gnu.tar.gz",
                    "sha256": "d8f303fc4ce1b9c4dd6db7da09e1c3e8af2fd659b7c3b80a46506ea9a0efbb76",
                    "x-checker-data": {
                        "type": "github",
                        "repo": "dashpay/dash",
                        "tag-pattern": "^v([0-9.]+)$",
                        "asset-name": "dashcore-${version}-aarch64-linux-gnu.tar.gz",
                        "update-group": "dash-core"
                    }
                }
            ]
        },
        {
            "name": "misc",
            "buildsystem": "simple",
            "build-commands": [
                "desktop-file-edit --set-key=\"Icon\" --set-value=${FLATPAK_ID} dash-qt.desktop",
                "install -Dp -m 644 dash-qt.desktop /app/share/applications/${FLATPAK_ID}.desktop",
                "install -Dp -m 644 dash-hicolor-scalable.svg /app/share/icons/hicolor/scalable/apps/org.dash.dash-core.svg",
                "install -Dp -m 644 org.dash.dash-core.metainfo.xml /app/share/metainfo/org.dash.dash-core.metainfo.xml",
                "install -m 0744 -D dash-entrypoint.sh /app/bin/dash-entrypoint.sh",
                "bash install_wrappers.sh"
            ],
            "sources": [
                {
                    "type": "file",
                    "url": "https://raw.githubusercontent.com/dashpay/dash/v24.0.3/contrib/debian/dash-qt.desktop",
                    "sha256": "59b6125eb0732137026d33e1e61dc8b84e20f90baba176cc84899c41cf8201df",
                    "x-checker-data": {
                        "type": "json",
                        "url": "https://api.github.com/repos/dashpay/dash/releases/latest",
                        "version-query": ".tag_name | sub(\"^v\"; \"\")",
                        "url-query": "\"https://raw.githubusercontent.com/dashpay/dash/\" + .tag_name + \"/contrib/debian/dash-qt.desktop\""
                    }
                },
                {
                    "type": "file",
                    "url": "https://raw.githubusercontent.com/dashpay/dash/v24.0.3/contrib/flatpak/org.dash.dash-core.metainfo.xml",
                    "sha256": "d6411a5919b882f895de9042797df083455a94e97a72ee9b02ef31702f8d98d0",
                    "x-checker-data": {
                        "type": "json",
                        "url": "https://api.github.com/repos/dashpay/dash/releases/latest",
                        "version-query": ".tag_name | sub(\"^v\"; \"\")",
                        "url-query": "\"https://raw.githubusercontent.com/dashpay/dash/\" + .tag_name + \"/contrib/flatpak/org.dash.dash-core.metainfo.xml\""
                    }
                },
                {
                    "type": "file",
                    "path": "dash-entrypoint.sh"
                },
                {
                    "type": "file",
                    "url": "https://raw.githubusercontent.com/dashpay/dash/v24.0.3/share/pixmaps/dash-hicolor-scalable.svg",
                    "sha256": "1a403de47c676dce5852d4f5facef22312edf28707ba4ae3d669ea208301aba7",
                    "x-checker-data": {
                        "type": "json",
                        "url": "https://api.github.com/repos/dashpay/dash/releases/latest",
                        "version-query": ".tag_name | sub(\"^v\"; \"\")",
                        "url-query": "\"https://raw.githubusercontent.com/dashpay/dash/\" + .tag_name + \"/share/pixmaps/dash-hicolor-scalable.svg\""
                    }
                },
                {
                    "type": "file",
                    "path": "install_wrappers.sh"
                }
            ]
        }
    ]
}
